(= (treeE1) (buildTree (parse "(OR (AND (NOT X2) (NOT X3) (OR (NOT X1) (NOT X4))) (AND (OR (AND (NOT X1) (NOT X4)) (AND (OR (NOT X1) (NOT X4)) X2 X3) (AND (OR (NOT X2) (NOT X3)) X1 X4)) (OR X2 X3)))")))
(= (treeE2) (buildTree (parse "(AND (OR (AND (NOT X1) (NOT X4)) (AND (OR (AND (NOT X2) X3) (NOT X1) (NOT X4)) (OR (AND X1 X4) (NOT X3) X2) (OR (NOT X2) X3))) (OR (NOT X2) (NOT X3) X1 X4))")))
(= (treeE3) (buildTree (parse "(AND (OR (AND (NOT X1) X2) (AND (NOT X2) X1) (AND (NOT X3) X4) (AND (NOT X4) X3)) (OR (AND X3 X4) (NOT X2) X1) (OR (NOT X1) (NOT X4) X2 X3))")))
(= (treeE4) (buildTree (parse "(OR (AND (NOT X1) (OR (NOT X4) X3) X2) (AND (NOT X2) (OR (NOT X3) X1) X4) (AND (NOT X3) (OR (NOT X2) X4) X1) (AND (NOT X4) (OR (NOT X1) X2) X3))")))
(= (treeE5) (buildTree (parse "(AND (OR (AND (NOT X1) X2 (OR X3 (NOT X4))) (AND X1 (NOT X3) (OR (NOT X2) X4)) (AND X3 (NOT X4) (OR (NOT X1) X2)) (AND (NOT X2) X4 (OR X1 (NOT X3)))))")))

(= (selectTargetTree E1) (treeE1))
(= (selectTargetTree "E1") (treeE1))
(= (selectTargetTree E2) (treeE2))
(= (selectTargetTree "E2") (treeE2))
(= (selectTargetTree E3) (treeE3))
(= (selectTargetTree "E3") (treeE3))
(= (selectTargetTree E4) (treeE4))
(= (selectTargetTree "E4") (treeE4))
(= (selectTargetTree E5) (treeE5))
(= (selectTargetTree "E5") (treeE5))

(= (scoreNeighbor $rep $inst $dist)
   (let $res (collapse (let* (($sc (complexityBasedScorer $rep (mkDemeId "1") (mkInst $inst) (parity4) 3.5))
                              ($raw (getScore $sc))
                              ($cpxy (getComp $sc))
                              ($pen (getPenScore $sc))
                              ($_rec (py-call (landscape_helper.record_neighbor $dist $raw $cpxy $pen)))
                             )
                         $raw))
        (if (== $res ()) 0 (car-atom $res))))

(= (evalInstances $rep $instances $dist)
   (map-atom $instances $inst (scoreNeighbor $rep $inst $dist)))

;; CLI parameter targetExemplar specifies which exemplar to run (default E1)
!(add-atom &params (targetExemplar E1))
!(apply-cli-overrides)

!(let* (($target (param targetExemplar))
        ($tree (selectTargetTree $target))
        ($argLabels (quote (X1 X2 X3 X4)))
        (($updatedTree $dscMp) (buildKnobs $tree () $argLabels True))
        ($rep (mkRep (mkKbMap (mkDscMp $dscMp)) $updatedTree))
        ($initInst (createInitialInstance $dscMp))
        ($baseScore (complexityBasedScorer $rep (mkDemeId "1") (mkInst $initInst) (parity4) 3.5))
        ($raw (getScore $baseScore))
        ($cpxy (getComp $baseScore))
        ($pen (getPenScore $baseScore))
        ($_p1 (println! ("\n=== Evaluating Exemplar:" $target "Center Raw:" $raw "Cpxy:" $cpxy "Pen:" $pen "===")))
        ($_st (py-call (landscape_helper.start_exemplar $target $raw $cpxy $pen)))
        ($specLists (discEffectiveSpecLists (mkDscMp $dscMp)))
        ;; Distance 1: Exhaustive
        ($dist1 (varyNKnobsBySpecLists $specLists $initInst 1))
        ($_p2 (println! ("  [Dist 1] Total neighbors:" (size-atom $dist1) "Evaluating...")))
        ($_e1 (evalInstances $rep $dist1 1))
        ($_save1 (py-call (landscape_helper.save_partial_results $target)))
        ;; Distance 2: Sample 500
        ($_p3 (println! ("  [Dist 2] Sampling 500 neighbors...")))
        ($dist2 (py-call (landscape_helper.generate_random_instances $initInst $specLists 2 500)))
        ($_e2 (evalInstances $rep $dist2 2))
        ($_save2 (py-call (landscape_helper.save_partial_results $target)))
        ;; Distance 3: Sample 500
        ($_p4 (println! ("  [Dist 3] Sampling 500 neighbors...")))
        ($dist3 (py-call (landscape_helper.generate_random_instances $initInst $specLists 3 500)))
        ($_e3 (evalInstances $rep $dist3 3))
        ($_save3 (py-call (landscape_helper.save_partial_results $target)))
        ($_p5 (println! ("  [Exemplar Complete]" $target)))
       )
   (println! "DONE"))

