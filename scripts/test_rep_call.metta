(= (treeE2) (buildTree (parse "(AND (OR (AND (NOT X1) (NOT X4)) (AND (OR (AND (NOT X2) X3) (NOT X1) (NOT X4)) (OR (AND X1 X4) (NOT X3) X2) (OR (NOT X2) X3))) (OR (NOT X2) (NOT X3) X1 X4))")))

(= (scoreNeighbor $rep $inst $dist)
   (let* (($sc (complexityBasedScorer $rep (mkDemeId "1") (mkInst $inst) (parity4) 3.5))
          ($raw (getScore $sc))
          ($cpxy (getComp $sc))
          ($pen (getPenScore $sc))
          ($_ (py-call (landscape_helper.record_neighbor $dist $raw $cpxy $pen)))
         )
     $raw))

(= (evalInstances $rep $instances $dist)
   (map-atom $instances $inst (scoreNeighbor $rep $inst $dist)))

(= (runExemplarLandscape $name $tree)
   (let* (($argLabels (quote (X1 X2 X3 X4)))
          (($updatedTree $dscMp) (buildKnobs $tree () $argLabels True))
          ($rep (mkRep (mkKbMap (mkDscMp $dscMp)) $updatedTree))
          ($initInst (createInitialInstance $dscMp))
          ($baseScore (complexityBasedScorer $rep (mkDemeId "1") (mkInst $initInst) (parity4) 3.5))
          ($raw (getScore $baseScore))
          ($cpxy (getComp $baseScore))
          ($pen (getPenScore $baseScore))
          ($_ (println! ("\n=== Processing Exemplar:" $name "Center Raw:" $raw "Cpxy:" $cpxy "Pen:" $pen "===")))
          ($_ (py-call (landscape_helper.start_exemplar $name $raw $cpxy $pen)))
          ($specLists (discEffectiveSpecLists (mkDscMp $dscMp)))
          ;; Distance 1: Exhaustive
          ($dist1 (varyNKnobsBySpecLists $specLists $initInst 1))
          ($_ (println! ("  [Dist 1] Total neighbors:" (size-atom $dist1) "Evaluating...")))
          ($_ (evalInstances $rep (take 5 $dist1) 1))
          ;; Distance 2: Sample 5
          ($_ (println! ("  [Dist 2] Sampling 5 neighbors...")))
          ($dist2 (py-call (landscape_helper.generate_random_instances $initInst $specLists 2 5)))
          ($_ (evalInstances $rep $dist2 2))
          ($_ (println! ("  [Done]" $name)))
         )
     $name))

(= (treeE4) (buildTree (parse "(OR (AND (NOT X1) (OR (NOT X4) X3) X2) (AND (NOT X2) (OR (NOT X3) X1) X4) (AND (NOT X3) (OR (NOT X2) X4) X1) (AND (NOT X4) (OR (NOT X1) X2) X3))")))

!(let* (($_rec (callPredicate (Predicate (py_add_lib_dir "scripts" first))))
        ($res (runExemplarLandscape "E4_test" (treeE4)))
       )
    (println! ("Result of E4:" $res)))






